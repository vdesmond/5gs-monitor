{
 "title": "5gs-monitor: slice SLA",
 "uid": "fivegs-monitor",
 "timezone": "browser",
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "URLLC latency (p50 / p95 / p99) vs SLA",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ue_rtt_ms{slice=\"urllc\",quantile=\"0.5\"}",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "expr": "ue_rtt_ms{slice=\"urllc\",quantile=\"0.95\"}",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "expr": "ue_rtt_ms{slice=\"urllc\",quantile=\"0.99\"}",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Slice throughput (downlink at the UE)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "rate(ue_tun_bytes_total{slice=\"embb\",direction=\"rx\"}[10s]) * 8 / 1e6",
     "legendFormat": "eMBB",
     "refId": "A"
    },
    {
     "expr": "rate(ue_tun_bytes_total{slice=\"urllc\",direction=\"rx\"}[10s]) * 8 / 1e6",
     "legendFormat": "URLLC",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Mbits",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "mean",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Controller: eMBB cap and SLA state",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "controller_cap_mbit",
     "legendFormat": "eMBB cap (Mbit/s)",
     "refId": "A"
    },
    {
     "expr": "controller_breach * 50",
     "legendFormat": "breach (x50)",
     "refId": "B"
    },
    {
     "expr": "controller_predicted_breach * 25",
     "legendFormat": "predicted breach (x25)",
     "refId": "C"
    },
    {
     "expr": "shaper_rate_mbit{dev=\"eth0\"}",
     "legendFormat": "cell capacity (Mbit/s)",
     "refId": "D"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Slice loss ratio",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ue_loss_ratio{slice=\"urllc\"}",
     "legendFormat": "URLLC",
     "refId": "A"
    },
    {
     "expr": "ue_loss_ratio{slice=\"embb\"}",
     "legendFormat": "eMBB",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "eMBB latency (p95)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "ue_rtt_ms{slice=\"embb\",quantile=\"0.95\"}",
     "legendFormat": "p95",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Core: PDU sessions per SMF",
   "gridPos": {
    "x": 8,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "fivegs_smffunction_sm_sessionnbr",
     "legendFormat": "{{release}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Core: registered UEs / QoS flows",
   "gridPos": {
    "x": 16,
    "y": 16,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "expr": "amf_session",
     "legendFormat": "AMF sessions",
     "refId": "A"
    },
    {
     "expr": "fivegs_amffunction_rm_registeredsubnbr",
     "legendFormat": "registered UEs",
     "refId": "B"
    },
    {
     "expr": "sum by (release) (fivegs_upffunction_upf_qosflows)",
     "legendFormat": "QoS flows {{release}}",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": []
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ],
 "tags": [
  "5g",
  "sla"
 ]
}